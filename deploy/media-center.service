[Unit]
Description=Home Media Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/media-center
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/media-center/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9080 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/media-center /var/cache/media-center
ReadOnlyPaths=/srv/media/readonly /srv/media/manage /srv/bridge

[Install]
WantedBy=multi-user.target
